#!/bin/sh
# Convención de commits (Conventional Commits): tipo(ámbito opcional): descripción
primera=$(head -n1 "$1")
case "$primera" in Merge\ *|Revert\ *) exit 0;; esac
if ! printf '%s' "$primera" | grep -Eq '^(feat|fix|docs|test|refactor|chore|perf|style|revert)(\([a-z0-9._-]+\))?!?: .{5,}'; then
  echo "Mensaje rechazado. Usa: tipo(ámbito): descripción   (tipos: feat fix docs test refactor chore perf style revert)" >&2
  echo "Ejemplo: feat(login): agrega sesión por cookie HttpOnly" >&2
  exit 1
fi
